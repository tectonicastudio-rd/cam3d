plugins {
    id 'com.android.application'
}

android {
    namespace 'com.tectonicastudio.cam3d'
    compileSdk 35

    defaultConfig {
        applicationId "com.tectonicastudio.cam3d"
        minSdk 24
        targetSdk 35
        versionCode 300
        versionName "3.0"
    }

    signingConfigs {
        debug {
            // firma de PRUEBA (solo para el APK compilado en GitHub). La oficial se usa con Build › Generate Signed APK.
            storeFile rootProject.file('ci/prueba.keystore')
            storePassword 'android'
            keyAlias 'androiddebugkey'
            keyPassword 'android'
        }
    }

    buildTypes {
        release {
            minifyEnabled false
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}

dependencies {
    implementation 'androidx.webkit:webkit:1.12.1'
    implementation 'com.google.ar:core:1.44.0'
}
