// CAM3D v3.0 · Tectónica Studio · Todos los derechos reservados
// App local: todo el programa va dentro de la app (carpeta www) y se sirve con cam3d://localhost
import UIKit
import WebKit
import AVFoundation
import Speech

// ------------------------------------------------------------ archivos locales
final class LocalAssetHandler: NSObject, WKURLSchemeHandler {
    let root: URL
    init(root: URL) { self.root = root }

    static func mime(_ ext: String) -> String {
        switch ext.lowercased() {
        case "html", "htm": return "text/html; charset=utf-8"
        case "js", "mjs": return "text/javascript; charset=utf-8"
        case "css": return "text/css; charset=utf-8"
        case "json", "webmanifest": return "application/json"
        case "png": return "image/png"
        case "jpg", "jpeg": return "image/jpeg"
        case "webp": return "image/webp"
        case "svg": return "image/svg+xml"
        case "gif": return "image/gif"
        case "wasm": return "application/wasm"
        case "glb": return "model/gltf-binary"
        case "txt": return "text/plain; charset=utf-8"
        default: return "application/octet-stream"
        }
    }

    func webView(_ webView: WKWebView, start urlSchemeTask: WKURLSchemeTask) {
        guard let url = urlSchemeTask.request.url else { return }
        var path = url.path
        if path.isEmpty || path == "/" { path = "/index.html" }
        let file = root.appendingPathComponent(String(path.dropFirst())).standardizedFileURL
        let inside = file.path.hasPrefix(root.standardizedFileURL.path)
        if inside, let data = try? Data(contentsOf: file) {
            let headers = ["Content-Type": LocalAssetHandler.mime(file.pathExtension),
                           "Content-Length": String(data.count),
                           "Access-Control-Allow-Origin": "*",
                           "Cache-Control": "no-cache"]
            if let r = HTTPURLResponse(url: url, statusCode: 200, httpVersion: "HTTP/1.1", headerFields: headers) {
                urlSchemeTask.didReceive(r)
            }
            urlSchemeTask.didReceive(data)
            urlSchemeTask.didFinish()
        } else {
            if let r = HTTPURLResponse(url: url, statusCode: 404, httpVersion: "HTTP/1.1", headerFields: ["Content-Type": "text/plain"]) {
                urlSchemeTask.didReceive(r)
            }
            urlSchemeTask.didReceive(Data())
            urlSchemeTask.didFinish()
        }
    }

    func webView(_ webView: WKWebView, stop urlSchemeTask: WKURLSchemeTask) {}
}

// evita ciclo de retención con el manejador de mensajes
final class WeakHandler: NSObject, WKScriptMessageHandler {
    weak var target: WKScriptMessageHandler?
    init(_ t: WKScriptMessageHandler) { target = t }
    func userContentController(_ c: WKUserContentController, didReceive m: WKScriptMessage) {
        target?.userContentController(c, didReceive: m)
    }
}

func jsString(_ s: String) -> String {
    if let d = try? JSONSerialization.data(withJSONObject: [s], options: []), let t = String(data: d, encoding: .utf8) {
        return String(t.dropFirst().dropLast())
    }
    return "\"\""
}

// ------------------------------------------------------------ puente con la app web
let bridgeJS = """
(function(){
  var H = window.webkit.messageHandlers.cam3d, R = null;
  window.__CAM3D_SET_RESULT = function(s){ R = s; };
  window.CAM3D_IOS = true;
  window.CAM3DNative = {
    startAR: function(m){ H.postMessage({op:'startAR', mode:String(m||'auto')}); },
    takeResult: function(){ var r = R; R = null; return r || ''; },
    saveFile: function(n, m, b){ H.postMessage({op:'saveFile', name:String(n), mime:String(m||''), b64:String(b||'')}); },
    listen: function(l, i){ H.postMessage({op:'listen', lang:String(l||'es-ES'), interim:!!i}); },
    stopListen: function(){ H.postMessage({op:'stopListen'}); },
    speak: function(t, r){ H.postMessage({op:'speak', text:String(t||''), rate:+r||1}); },
    stopSpeak: function(){ H.postMessage({op:'stopSpeak'}); },
    version: function(){ return '3.0-ios'; },
    hasCamera: function(){ return true; }
  };
  var TXT = '✅ Cámara AR nativa del iPhone (ARKit). En los modelos con LiDAR el escaneo usa el sensor de profundidad.';
  function fix(){ var e = document.getElementById('arStatus'); if (e && /ARCore|Google Play/.test(e.innerHTML)) e.innerHTML = TXT; }
  document.addEventListener('DOMContentLoaded', function(){
    fix(); try { new MutationObserver(fix).observe(document.body, {subtree:true, childList:true, characterData:true}); } catch(e){}
  });
})();
"""

final class WebViewController: UIViewController, WKScriptMessageHandler, WKNavigationDelegate, WKUIDelegate {
    var web: WKWebView!
    let synth = AVSpeechSynthesizer()
    let dictation = Dictation()

    override var preferredStatusBarStyle: UIStatusBarStyle { .lightContent }

    override func viewDidLoad() {
        super.viewDidLoad()
        view.backgroundColor = UIColor(red: 0.024, green: 0.043, blue: 0.086, alpha: 1)

        let cfg = WKWebViewConfiguration()
        let root = Bundle.main.url(forResource: "www", withExtension: nil) ?? Bundle.main.bundleURL
        cfg.setURLSchemeHandler(LocalAssetHandler(root: root), forURLScheme: "cam3d")
        cfg.allowsInlineMediaPlayback = true
        cfg.mediaTypesRequiringUserActionForPlayback = []
        cfg.websiteDataStore = .default()
        let uc = WKUserContentController()
        uc.addUserScript(WKUserScript(source: bridgeJS, injectionTime: .atDocumentStart, forMainFrameOnly: true))
        uc.add(WeakHandler(self), name: "cam3d")
        cfg.userContentController = uc

        web = WKWebView(frame: .zero, configuration: cfg)
        web.isOpaque = false
        web.backgroundColor = view.backgroundColor
        web.scrollView.backgroundColor = view.backgroundColor
        web.scrollView.contentInsetAdjustmentBehavior = .never
        web.scrollView.bounces = false
        web.navigationDelegate = self
        web.uiDelegate = self
        if #available(iOS 16.4, *) { web.isInspectable = true }
        web.translatesAutoresizingMaskIntoConstraints = false
        view.addSubview(web)
        NSLayoutConstraint.activate([
            web.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
            web.bottomAnchor.constraint(equalTo: view.bottomAnchor),
            web.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            web.trailingAnchor.constraint(equalTo: view.trailingAnchor)
        ])

        dictation.emit = { [weak self] type, text, fin in
            self?.js("window.CAM3DSpeech && CAM3DSpeech(\(jsString(type)), \(jsString(text)), \(fin ? "true" : "false"))")
        }

        if let u = URL(string: "cam3d://localhost/index.html") { web.load(URLRequest(url: u)) }
    }

    func js(_ code: String) {
        DispatchQueue.main.async { self.web.evaluateJavaScript(code, completionHandler: nil) }
    }

    // mensajes que envía la app web
    func userContentController(_ userContentController: WKUserContentController, didReceive message: WKScriptMessage) {
        guard let d = message.body as? [String: Any], let op = d["op"] as? String else { return }
        switch op {
        case "startAR":
            startAR(d["mode"] as? String ?? "auto")
        case "saveFile":
            saveFile(name: d["name"] as? String ?? "CAM3D", b64: d["b64"] as? String ?? "")
        case "listen":
            synth.stopSpeaking(at: .immediate)
            dictation.start(lang: d["lang"] as? String ?? "es-ES", interim: d["interim"] as? Bool ?? true)
        case "stopListen":
            dictation.finish()
        case "speak":
            speak(d["text"] as? String ?? "", rate: (d["rate"] as? Double) ?? 1)
        case "stopSpeak":
            synth.stopSpeaking(at: .immediate)
        default:
            break
        }
    }

    func speak(_ text: String, rate: Double) {
        guard !text.isEmpty else { return }
        synth.stopSpeaking(at: .immediate)
        let u = AVSpeechUtterance(string: text)
        u.voice = AVSpeechSynthesisVoice(language: "es-MX") ?? AVSpeechSynthesisVoice(language: "es-ES")
        u.rate = Float(max(0.3, min(1.6, rate))) * AVSpeechUtteranceDefaultSpeechRate
        synth.speak(u)
    }

    // cámara AR nativa (ARKit)
    func startAR(_ mode: String) {
        guard presentedViewController == nil else { return }
        synth.stopSpeaking(at: .immediate)
        let vc = ARCaptureViewController()
        vc.mode = mode
        vc.modalPresentationStyle = .fullScreen
        vc.onFinish = { [weak self] json in
            guard let self = self, let json = json else { return }
            self.js("window.__CAM3D_SET_RESULT(\(jsString(json))); window.CAM3DNativeAR && window.CAM3DNativeAR();")
        }
        present(vc, animated: true)
    }

    // guardar exportaciones: carpeta Archivos › CAM3D y menú Compartir
    func saveFile(name: String, b64: String) {
        guard let data = Data(base64Encoded: b64, options: .ignoreUnknownCharacters) else { return }
        let safe = name.replacingOccurrences(of: "/", with: "_").replacingOccurrences(of: ":", with: "_")
        let dir = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("CAM3D", isDirectory: true)
        try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
        let url = dir.appendingPathComponent(safe.isEmpty ? "CAM3D" : safe)
        do { try data.write(to: url, options: .atomic) } catch { return }
        let av = UIActivityViewController(activityItems: [url], applicationActivities: nil)
        if let p = av.popoverPresentationController {
            p.sourceView = view
            p.sourceRect = CGRect(x: view.bounds.midX, y: view.bounds.midY, width: 1, height: 1)
            p.permittedArrowDirections = []
        }
        DispatchQueue.main.async { self.present(av, animated: true) }
    }

    // enlaces externos se abren en Safari
    func webView(_ webView: WKWebView, decidePolicyFor navigationAction: WKNavigationAction, decisionHandler: @escaping (WKNavigationActionPolicy) -> Void) {
        if let u = navigationAction.request.url, let s = u.scheme?.lowercased(), s != "cam3d", s != "about", s != "blob", s != "data" {
            if navigationAction.navigationType == .linkActivated || navigationAction.targetFrame == nil || navigationAction.targetFrame?.isMainFrame == true {
                UIApplication.shared.open(u)
                decisionHandler(.cancel)
                return
            }
        }
        decisionHandler(.allow)
    }

    func webView(_ webView: WKWebView, createWebViewWith configuration: WKWebViewConfiguration, for navigationAction: WKNavigationAction, windowFeatures: WKWindowFeatures) -> WKWebView? {
        if let u = navigationAction.request.url, u.scheme?.lowercased() != "cam3d" { UIApplication.shared.open(u) }
        return nil
    }

    @available(iOS 15.0, *)
    func webView(_ webView: WKWebView, requestMediaCapturePermissionFor origin: WKSecurityOrigin, initiatedByFrame frame: WKFrameInfo, type: WKMediaCaptureType, decisionHandler: @escaping (WKPermissionDecision) -> Void) {
        decisionHandler(.grant)
    }

    func webView(_ webView: WKWebView, runJavaScriptAlertPanelWithMessage message: String, initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping () -> Void) {
        let a = UIAlertController(title: "CAM3D", message: message, preferredStyle: .alert)
        a.addAction(UIAlertAction(title: "OK", style: .default) { _ in completionHandler() })
        present(a, animated: true)
    }

    func webView(_ webView: WKWebView, runJavaScriptConfirmPanelWithMessage message: String, initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping (Bool) -> Void) {
        let a = UIAlertController(title: "CAM3D", message: message, preferredStyle: .alert)
        a.addAction(UIAlertAction(title: "Cancelar", style: .cancel) { _ in completionHandler(false) })
        a.addAction(UIAlertAction(title: "OK", style: .default) { _ in completionHandler(true) })
        present(a, animated: true)
    }

    func webViewWebContentProcessDidTerminate(_ webView: WKWebView) { webView.reload() }
}

// ------------------------------------------------------------ dictado por voz (Speech)
final class Dictation {
    var emit: ((String, String, Bool) -> Void)?
    private let engine = AVAudioEngine()
    private var request: SFSpeechAudioBufferRecognitionRequest?
    private var task: SFSpeechRecognitionTask?
    private var recognizer: SFSpeechRecognizer?
    private var silence: Timer?
    private var cap: Timer?
    private var active = false

    func start(lang: String, interim: Bool) {
        if active { finish(); return }
        SFSpeechRecognizer.requestAuthorization { st in
            DispatchQueue.main.async {
                guard st == .authorized else { self.fail("not-allowed"); return }
                AVAudioSession.sharedInstance().requestRecordPermission { ok in
                    DispatchQueue.main.async {
                        if ok { self.begin(lang: lang, interim: interim) } else { self.fail("not-allowed") }
                    }
                }
            }
        }
    }

    private func fail(_ e: String) {
        emit?("error", e, false)
        emit?("end", "", false)
    }

    private func begin(lang: String, interim: Bool) {
        let rec = SFSpeechRecognizer(locale: Locale(identifier: lang)) ?? SFSpeechRecognizer(locale: Locale(identifier: "es-ES"))
        guard let r = rec, r.isAvailable else { fail("network"); return }
        recognizer = r
        do {
            let s = AVAudioSession.sharedInstance()
            try s.setCategory(.playAndRecord, mode: .measurement, options: [.defaultToSpeaker, .allowBluetooth])
            try s.setActive(true, options: .notifyOthersOnDeactivation)
        } catch { fail("audio-capture"); return }
        let req = SFSpeechAudioBufferRecognitionRequest()
        req.shouldReportPartialResults = interim
        request = req
        let input = engine.inputNode
        let fmt = input.outputFormat(forBus: 0)
        input.removeTap(onBus: 0)
        input.installTap(onBus: 0, bufferSize: 1024, format: fmt) { buf, _ in req.append(buf) }
        engine.prepare()
        do { try engine.start() } catch { input.removeTap(onBus: 0); restoreAudio(); fail("audio-capture"); return }
        active = true
        emit?("start", "", false)
        task = r.recognitionTask(with: req) { [weak self] res, err in
            DispatchQueue.main.async {
                guard let self = self, self.active else { return }
                if let res = res {
                    self.emit?("result", res.bestTranscription.formattedString, res.isFinal)
                    if res.isFinal { self.stop(); return }
                    self.armSilence()
                }
                if err != nil { self.stop() }
            }
        }
        armSilence()
        cap = Timer.scheduledTimer(withTimeInterval: 15, repeats: false) { [weak self] _ in self?.finish() }
    }

    private func armSilence() {
        silence?.invalidate()
        silence = Timer.scheduledTimer(withTimeInterval: 1.8, repeats: false) { [weak self] _ in self?.finish() }
    }

    // termina de escuchar y espera el resultado final
    func finish() {
        guard active else { return }
        silence?.invalidate(); cap?.invalidate()
        if engine.isRunning { engine.stop(); engine.inputNode.removeTap(onBus: 0) }
        request?.endAudio()
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) { [weak self] in self?.stop() }
    }

    private func stop() {
        guard active else { return }
        active = false
        silence?.invalidate(); cap?.invalidate()
        if engine.isRunning { engine.stop(); engine.inputNode.removeTap(onBus: 0) }
        request?.endAudio(); task?.cancel()
        request = nil; task = nil
        restoreAudio()
        emit?("end", "", false)
    }

    private func restoreAudio() {
        try? AVAudioSession.sharedInstance().setCategory(.playback, mode: .default, options: [.mixWithOthers])
    }
}
